diff --git a/drivers/gpu/drm/imagination/pvr_apple.c b/drivers/gpu/drm/imagination/pvr_apple.c
index 71a3b01..2819797 100644
--- a/drivers/gpu/drm/imagination/pvr_apple.c
+++ b/drivers/gpu/drm/imagination/pvr_apple.c
@@ -34,6 +34,7 @@
 #include <drm/drm_print.h>
 #include <drm/gpu_scheduler.h>
 #include <linux/debugfs.h>
+#include <linux/vmalloc.h>
 #include <linux/delay.h>
 #include <linux/dma-fence.h>
 #include <linux/dma-mapping.h>
@@ -185,6 +186,36 @@ MODULE_PARM_DESC(apple_rt_size,
 
 /* The fragment self-test's last target, at <debugfs>/apple_target */
 static struct debugfs_blob_wrapper pvr_apple_target_blob;
+
+/*
+ * apple_timeline=1 (bring-up only): job submissions and completions with
+ * their times at <debugfs>/apple_timeline (a ring: sort by time), 16-byte records {u64 ns, u32
+ * event << 16 | engine, u32 seq}: event 0 a job reached the queue, 1 written
+ * and the doorbell rung, 2 its fence signalled, 3 a geometry job saw the
+ * previous fragment job retired
+ */
+static bool pvr_apple_timeline;
+module_param_named(apple_timeline, pvr_apple_timeline, bool, 0644);
+#define APPLE_TIMELINE_LEN	65536
+struct pvr_apple_tl {
+	u64 ns;
+	u32 ev;
+	u32 seq;
+};
+static struct pvr_apple_tl *pvr_apple_tl;
+static atomic_t pvr_apple_tl_n;
+static struct debugfs_blob_wrapper pvr_apple_tl_blob;
+static struct dentry *pvr_apple_tl_file;
+
+static void pvr_apple_tl_add(u32 ev, u32 engine, u32 seq)
+{
+	unsigned int i;
+
+	if (!pvr_apple_timeline || !pvr_apple_tl)
+		return;
+	i = (atomic_inc_return(&pvr_apple_tl_n) - 1) % APPLE_TIMELINE_LEN;
+	pvr_apple_tl[i] = (struct pvr_apple_tl){ ktime_get_ns(), ev << 16 | engine, seq };
+}
 static struct dentry *pvr_apple_target_file;
 
 static unsigned int pvr_apple_ta_variant;
@@ -370,6 +401,14 @@ static int pvr_apple_power_init(struct pvr_device *pvr_dev)
 	 */
 	pm_runtime_forbid(dev);
 
+	if (pvr_apple_timeline && !pvr_apple_tl) {
+		pvr_apple_tl = vzalloc(APPLE_TIMELINE_LEN * sizeof(*pvr_apple_tl));
+		pvr_apple_tl_blob.data = pvr_apple_tl;
+		pvr_apple_tl_blob.size = pvr_apple_tl ? APPLE_TIMELINE_LEN * sizeof(*pvr_apple_tl) : 0;
+		pvr_apple_tl_file = debugfs_create_blob("apple_timeline", 0400, NULL,
+							&pvr_apple_tl_blob);
+	}
+
 	return 0;
 }
 
@@ -814,6 +853,7 @@ static void pvr_apple_poll_work(struct work_struct *work)
 			if ((s32)(done - (u32)fence->base.seqno) < 0)
 				break;
 			list_del_init(&fence->node);
+			pvr_apple_tl_add(2, engine, fence->base.seqno);
 			dma_fence_signal_locked(&fence->base);
 			dma_fence_put(&fence->base);
 		}
@@ -1080,6 +1120,7 @@ static int pvr_apple_queue_render(struct pvr_apple *apple, struct pvr_vm_context
 	u32 seq, producer;
 	int err;
 
+	pvr_apple_tl_add(0, engine, 0);
 	mutex_lock(&apple->submit_lock);
 	err = pvr_apple_wait_engine(apple, engine, pvr_apple_engine_last(apple, engine), 5000000);
 	if (!err && pvr_vm_get_page_table_root_addr(vm_ctx) != apple->vm_root)
@@ -1128,6 +1169,8 @@ static int pvr_apple_queue_render(struct pvr_apple *apple, struct pvr_vm_context
 	}
 	if (err)
 		goto out_unlock;
+	if (engine == APPLE_ENGINE_GEOM)
+		pvr_apple_tl_add(3, engine, apple->frag_seq);
 	pvr_apple_switch_vm(apple, vm_ctx);
 	if (engine == APPLE_ENGINE_GEOM) {
 		if (pvr_apple_pm_trace && !((apple->ta_seq + 1) % pvr_apple_pm_trace))
@@ -1146,6 +1189,7 @@ static int pvr_apple_queue_render(struct pvr_apple *apple, struct pvr_vm_context
 	wmb();
 	err = apple_rtkit_send_message(apple->rtk, APPLE_EP_AGX_DOORBELL, APPLE_MSG_KICK, NULL,
 				       false);
+	pvr_apple_tl_add(1, engine, seq);
 	if (!err)
 		err = seq;
 out_unlock:
@@ -2291,6 +2335,10 @@ void pvr_apple_fw_fini(struct pvr_device *pvr_dev)
 	pvr_apple_target_file = NULL;
 	kvfree(pvr_apple_target_blob.data);
 	pvr_apple_target_blob.data = NULL;
+	debugfs_remove(pvr_apple_tl_file);
+	pvr_apple_tl_file = NULL;
+	vfree(pvr_apple_tl);
+	pvr_apple_tl = NULL;
 	if (apple->booted)
 		pvr_apple_switch_to_kernel_vm(apple, NULL);
 	pvr_apple_cancel_fences(apple, -ENODEV);
