// GPU effect demo kernel for pvr-fx: animated Julia set, smooth coloring,
// cosine palette. One kernel per line (tools/isa/explore.py compiles it).
#include <metal_stdlib>
using namespace metal;
kernel void fx(device uint *o [[buffer(0)]], uint l [[thread_index_in_threadgroup]], uint2 g [[threadgroup_position_in_grid]]) { uint x = g.x * 64u + l; uint y = g.y; float cx = as_type<float>(o[1]); float cy = as_type<float>(o[2]); float zoom = as_type<float>(o[3]); float shift = as_type<float>(o[4]); float zx = (float(x) - 384.0f) * zoom; float zy = (float(y) - 512.0f) * zoom; float m = 0.0f; int i = 0; for (; i < 128; i++) { float xx = zx * zx; float yy = zy * zy; m = xx + yy; if (m > 256.0f) break; zy = 2.0f * zx * zy + cy; zx = xx - yy + cx; } float3 col = float3(0.0f); if (i < 128) { float s = float(i) - log2(log2(m)) + 4.0f; float t = 0.035f * s + shift; col = 0.5f + 0.5f * cos(6.2831853f * (float3(1.0f, 1.0f, 1.0f) * t + float3(0.0f, 0.33f, 0.67f))); col *= clamp(0.25f * s, 0.0f, 1.0f); } uint ri = uint(clamp(col.x, 0.0f, 1.0f) * 255.0f); uint gi = uint(clamp(col.y, 0.0f, 1.0f) * 255.0f); uint bi = uint(clamp(col.z, 0.0f, 1.0f) * 255.0f); o[16u + y * 768u + x] = 0xff000000u | (ri << 16) | (gi << 8) | bi; }
