index 000000000..afc4ec374
--- /dev/null
+++ b/drivers/gpu/drm/imagination/pvr_apple.c
@@ -0,0 +1,670 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * Apple A10 (T8010) support: Rogue fixed-function hardware driven by Apple's
+ * GFX firmware instead of Imagination's.
+ *
+ * The firmware runs on "gfx-kf", an AppleA7IOP V2 coprocessor, and speaks RTKit
+ * through the A7IOP mailbox. It powers the Rogue core through the "Fender"
+ * block; the AP may only touch RGX registers once Fender reports power state 1.
+ * The firmware maps host memory itself: a 1 MiB window at IOP address 0 holds
+ * the image and the init page, and a heap is mapped through memory descriptors
+ * (see pvr_apple_layout.c).
+ *
+ * Messages, AGX endpoints:
+ *   0x20  init: 0x81 << 48 | physical address of the init page
+ *   0x21  doorbell: 0x83 << 48 makes the firmware scan its rings
+ */
+
+#include "pvr_apple.h"
+#include "pvr_apple_layout.h"
+#include "pvr_device.h"
+#include "pvr_gem.h"
+#include "pvr_mmu.h"
+#include "pvr_power.h"
+#include "pvr_rogue_cr_defs.h"
+#include "pvr_vm.h"
+
+#include <drm/drm_print.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/firmware.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/soc/apple/rtkit.h>
+
+#define APPLE_EP_AGX_INIT		0x20
+#define APPLE_EP_AGX_DOORBELL		0x21
+#define APPLE_MSG_INIT			(0x81ull << 48)
+#define APPLE_MSG_KICK			(0x83ull << 48)
+
+/* Fender: power-state request/acknowledge, the firmware window, the run bit */
+#define FENDER_POWER_STATE		0x1000
+#define FENDER_POWER_STATE_MASK		0x1f
+#define FENDER_POWER_REQUEST		0x10	/* | target state */
+#define FENDER_WINDOW			0x200c
+#define FENDER_RUN			0x2048
+#define FENDER_RUN_ENABLE		BIT(0)
+
+/* A7IOP: the IOP's copy of the firmware window */
+#define IOP_WINDOW			0x0008
+#define IOP_WINDOW_ENABLE		0x0038
+
+/* Heap: U+0x14 becomes 1 once the firmware accepted the init data */
+#define HEAP_U_READY			(0x5000 + 0x14)
+
+struct pvr_apple {
+	struct pvr_device *pvr_dev;
+	void __iomem *fender;
+	void __iomem *iop;
+	struct apple_rtkit *rtk;
+
+	void *win;
+	dma_addr_t win_dma;
+	size_t win_next;	/* RTKit buffers are carved after the image */
+	void *heap;
+	dma_addr_t heap_dma;
+	bool booted;
+
+	struct mutex submit_lock;	/* job slots, rings, producer index, GPU VM */
+	u32 last_seq;			/* last submitted compute job */
+	dma_addr_t vm_root;		/* page-table root GPU context 0 runs on */
+
+	/* GPU pages of the kernel VM context used by the compute command */
+	struct pvr_apple_gpu_page {
+		struct pvr_gem_object *obj;
+		u8 *map;
+		u64 device_addr;
+	} data, code, out;
+};
+
+static unsigned int pvr_apple_selftest;
+module_param_named(apple_selftest, pvr_apple_selftest, uint, 0400);
+MODULE_PARM_DESC(apple_selftest,
+		 "Bring-up only (Apple A10): after firmware init, run 1 = a terminate-only compute job, 2 = a shader storing 0x1357, 3 = both in sequence, 4 = store, then store in a second GPU VM");
+
+/* The heap is coherent memory shared with the firmware, not MMIO. */
+static u32 heap_read32(struct pvr_apple *apple, u32 offset)
+{
+	return le32_to_cpu(READ_ONCE(*(__le32 *)(apple->heap + offset)));
+}
+
+static struct pvr_apple *to_apple(struct pvr_device *pvr_dev)
+{
+	return pvr_dev->apple;
+}
+
+static struct device *apple_dev(struct pvr_apple *apple)
+{
+	return from_pvr_device(apple->pvr_dev)->dev;
+}
+
+static int pvr_apple_shmem_setup(void *cookie, struct apple_rtkit_shmem *bfr)
+{
+	struct pvr_apple *apple = cookie;
+	size_t size = ALIGN(bfr->size, SZ_4K);
+
+	if (bfr->iova) {
+		/* Firmware-chosen address: must lie inside the window */
+		if (bfr->iova + bfr->size > PVR_APPLE_WINDOW_SIZE)
+			return -EINVAL;
+		bfr->buffer = apple->win + bfr->iova;
+		bfr->is_mapped = true;
+		return 0;
+	}
+	if (apple->win_next + size > pvr_apple_layout_init_offset())
+		return -ENOMEM;
+	bfr->iova = apple->win_next;
+	bfr->buffer = apple->win + apple->win_next;
+	apple->win_next += size;
+	return 0;
+}
+
+static void pvr_apple_shmem_destroy(void *cookie, struct apple_rtkit_shmem *bfr)
+{
+	/* Carved from the window, which lives as long as the device */
+}
+
+static void pvr_apple_recv_message(void *cookie, u8 endpoint, u64 message)
+{
+	struct pvr_apple *apple = cookie;
+
+	dev_dbg(apple_dev(apple), "firmware ep %#x: %#016llx\n", endpoint, message);
+}
+
+static void pvr_apple_crashed(void *cookie, const void *crashlog, size_t size)
+{
+	struct pvr_apple *apple = cookie;
+
+	dev_err(apple_dev(apple), "GFX firmware crashed (%zu byte crashlog)\n", size);
+	if (crashlog)
+		print_hex_dump(KERN_ERR, "crashlog: ", DUMP_PREFIX_OFFSET, 16, 1, crashlog,
+			       min_t(size_t, size, 256), true);
+}
+
+static const struct apple_rtkit_ops pvr_apple_rtkit_ops = {
+	.crashed = pvr_apple_crashed,
+	.recv_message = pvr_apple_recv_message,
+	.shmem_setup = pvr_apple_shmem_setup,
+	.shmem_destroy = pvr_apple_shmem_destroy,
+};
+
+/* The window is programmed in two copies: Fender (4-byte stride) and IOP (8). */
+static void pvr_apple_set_window(struct pvr_apple *apple)
+{
+	const u32 fields[] = {
+		lower_32_bits(apple->win_dma), upper_32_bits(apple->win_dma),
+		0, 0, PVR_APPLE_WINDOW_SIZE, 0,
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(fields); i++) {
+		writel(fields[i], apple->fender + FENDER_WINDOW + 4 * i);
+		writel(fields[i], apple->iop + IOP_WINDOW + 8 * i);
+	}
+	writel(1, apple->iop + IOP_WINDOW_ENABLE);
+}
+
+static int pvr_apple_request_power_state(struct pvr_apple *apple, u32 state)
+{
+	u32 val;
+	int err;
+
+	writel(FENDER_POWER_REQUEST | state, apple->fender + FENDER_POWER_STATE);
+	err = readl_poll_timeout(apple->fender + FENDER_POWER_STATE, val,
+				 (val & FENDER_POWER_STATE_MASK) == state, 100, 100000);
+	if (err)
+		dev_err(apple_dev(apple), "Fender power state %u not reached (%#x)\n", state, val);
+	return err;
+}
+
+static int pvr_apple_power_init(struct pvr_device *pvr_dev)
+{
+	struct device *dev = from_pvr_device(pvr_dev)->dev;
+	struct platform_device *pdev = to_platform_device(dev);
+	const struct firmware *fw;
+	struct pvr_apple *apple;
+	const char *name = "apple/gfx-t8010.bin";
+	int err;
+
+	apple = devm_kzalloc(dev, sizeof(*apple), GFP_KERNEL);
+	if (!apple)
+		return -ENOMEM;
+	apple->pvr_dev = pvr_dev;
+	pvr_dev->apple = apple;
+	err = devm_mutex_init(dev, &apple->submit_lock);
+	if (err)
+		return err;
+
+	apple->fender = devm_platform_ioremap_resource_byname(pdev, "fender");
+	if (IS_ERR(apple->fender))
+		return PTR_ERR(apple->fender);
+	apple->iop = devm_platform_ioremap_resource_byname(pdev, "iop");
+	if (IS_ERR(apple->iop))
+		return PTR_ERR(apple->iop);
+
+	/* The firmware addresses host memory physically through its own MMU. */
+	err = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(40));
+	if (err)
+		return err;
+	apple->win = dmam_alloc_coherent(dev, PVR_APPLE_WINDOW_SIZE, &apple->win_dma, GFP_KERNEL);
+	apple->heap = dmam_alloc_coherent(dev, PVR_APPLE_HEAP_SIZE, &apple->heap_dma, GFP_KERNEL);
+	if (!apple->win || !apple->heap)
+		return -ENOMEM;
+	if (!IS_ALIGNED(apple->win_dma, SZ_16K))
+		return dev_err_probe(dev, -EINVAL, "firmware window %pad not 16 KiB aligned\n",
+				     &apple->win_dma);
+	apple->win_next = PVR_APPLE_FW_RUNTIME;
+
+	of_property_read_string(dev->of_node, "firmware-name", &name);
+	err = request_firmware(&fw, name, dev);
+	if (err)
+		return dev_err_probe(dev, err, "cannot load %s\n", name);
+	if (fw->size > PVR_APPLE_FW_RUNTIME) {
+		release_firmware(fw);
+		return dev_err_probe(dev, -EINVAL, "%s too large\n", name);
+	}
+	memcpy(apple->win, fw->data, fw->size);
+	release_firmware(fw);
+
+	apple->rtk = devm_apple_rtkit_init(dev, apple, NULL, 0, &pvr_apple_rtkit_ops);
+	if (IS_ERR(apple->rtk))
+		return dev_err_probe(dev, PTR_ERR(apple->rtk), "RTKit init failed\n");
+
+	return 0;
+}
+
+static int pvr_apple_power_on(struct pvr_device *pvr_dev)
+{
+	struct pvr_apple *apple = to_apple(pvr_dev);
+	struct device *dev = apple_dev(apple);
+	u32 state;
+	int err;
+
+	if (apple->booted)
+		return 0;
+
+	pvr_apple_set_window(apple);
+	writel(readl(apple->fender + FENDER_RUN) | FENDER_RUN_ENABLE, apple->fender + FENDER_RUN);
+
+	err = apple_rtkit_boot(apple->rtk);
+	if (err) {
+		dev_err(dev, "GFX firmware boot failed: %d\n", err);
+		goto err_stop;
+	}
+	err = apple_rtkit_start_ep(apple->rtk, APPLE_EP_AGX_INIT);
+	if (!err)
+		err = apple_rtkit_start_ep(apple->rtk, APPLE_EP_AGX_DOORBELL);
+	if (err)
+		goto err_shutdown;
+
+	/* A core left on by a previous boot is reset through state 0 first. */
+	state = readl(apple->fender + FENDER_POWER_STATE) & FENDER_POWER_STATE_MASK;
+	if (state != 0) {
+		err = pvr_apple_request_power_state(apple, 0);
+		if (err)
+			goto err_shutdown;
+	}
+	err = pvr_apple_request_power_state(apple, 1);
+	if (err)
+		goto err_shutdown;
+
+	apple->booted = true;
+	return 0;
+
+err_shutdown:
+	apple_rtkit_shutdown(apple->rtk);
+err_stop:
+	writel(readl(apple->fender + FENDER_RUN) & ~FENDER_RUN_ENABLE, apple->fender + FENDER_RUN);
+	return err;
+}
+
+static int pvr_apple_power_off(struct pvr_device *pvr_dev)
+{
+	/*
+	 * The firmware keeps its init data across idle periods; powering down and
+	 * re-initializing it is not implemented yet, so the GPU stays on.
+	 */
+	return 0;
+}
+
+const struct pvr_power_sequence_ops pvr_power_sequence_ops_apple = {
+	.init = pvr_apple_power_init,
+	.power_on = pvr_apple_power_on,
+	.power_off = pvr_apple_power_off,
+};
+
+static void wr32(u8 *base, u32 offset, u32 value)
+{
+	*(__le32 *)(base + offset) = cpu_to_le32(value);
+}
+
+static int pvr_apple_gpu_page_init_vm(struct pvr_apple *apple, struct pvr_vm_context *vm_ctx,
+				      struct pvr_apple_gpu_page *page, u64 device_addr)
+{
+	struct pvr_device *pvr_dev = apple->pvr_dev;
+	int err;
+
+	page->obj = pvr_gem_object_create(pvr_dev, PVR_DEVICE_PAGE_SIZE,
+					  PVR_BO_FW_FLAGS_DEVICE_UNCACHED);
+	if (IS_ERR(page->obj))
+		return PTR_ERR(page->obj);
+	page->map = pvr_gem_object_vmap(page->obj);
+	if (IS_ERR(page->map)) {
+		err = PTR_ERR(page->map);
+		goto err_put;
+	}
+	memset(page->map, 0, PVR_DEVICE_PAGE_SIZE);
+	err = pvr_vm_map(vm_ctx, page->obj, 0, device_addr, PVR_DEVICE_PAGE_SIZE);
+	if (err)
+		goto err_vunmap;
+	page->device_addr = device_addr;
+	return 0;
+
+err_vunmap:
+	pvr_gem_object_vunmap(page->obj);
+err_put:
+	pvr_gem_object_put(page->obj);
+	page->obj = NULL;
+	return err;
+}
+
+static int pvr_apple_gpu_page_init(struct pvr_apple *apple, struct pvr_apple_gpu_page *page,
+				   u64 device_addr)
+{
+	return pvr_apple_gpu_page_init_vm(apple, apple->pvr_dev->kernel_vm_ctx, page, device_addr);
+}
+
+static void pvr_apple_gpu_page_fini_vm(struct pvr_apple *apple, struct pvr_vm_context *vm_ctx,
+				       struct pvr_apple_gpu_page *page)
+{
+	if (!page->obj)
+		return;
+	pvr_vm_unmap_obj(vm_ctx, page->obj, page->device_addr, PVR_DEVICE_PAGE_SIZE);
+	pvr_gem_object_vunmap(page->obj);
+	pvr_gem_object_put(page->obj);
+	page->obj = NULL;
+}
+
+static void pvr_apple_gpu_page_fini(struct pvr_apple *apple, struct pvr_apple_gpu_page *page)
+{
+	pvr_apple_gpu_page_fini_vm(apple, apple->pvr_dev->kernel_vm_ctx, page);
+}
+
+static void pvr_apple_gpu_pages_fini(struct pvr_apple *apple)
+{
+	pvr_apple_gpu_page_fini(apple, &apple->out);
+	pvr_apple_gpu_page_fini(apple, &apple->code);
+	pvr_apple_gpu_page_fini(apple, &apple->data);
+}
+
+static int pvr_apple_gpu_pages_init(struct pvr_apple *apple)
+{
+	int err;
+
+	err = pvr_apple_gpu_page_init(apple, &apple->data, PVR_APPLE_GPU_DATA);
+	if (!err)
+		err = pvr_apple_gpu_page_init(apple, &apple->code, PVR_APPLE_GPU_CODE);
+	if (!err)
+		err = pvr_apple_gpu_page_init(apple, &apple->out, PVR_APPLE_GPU_OUTPUT);
+	if (err) {
+		pvr_apple_gpu_pages_fini(apple);
+		return err;
+	}
+
+	/* Terminate-only stream; HALT for the terminate and context PDS programs */
+	wr32(apple->data.map, 0x0000, 0x80000000);
+	wr32(apple->data.map, 0x1000, 0xd3000000);
+	wr32(apple->code.map, 0x0000, 0xd3000000);
+	return 0;
+}
+
+/*
+ * A one-thread compute dispatch as iPadOS submits it: CDM record 0 is a
+ * DMA-only PDS task loading the buffer binding into the USC common store,
+ * record 1 the kernel. The USC code is store_marker (out[0] = 0x1357),
+ * compiled by Apple's offline compiler for applegpu_g9p.
+ */
+static void pvr_apple_write_store_job(struct pvr_apple_gpu_page *data,
+				      struct pvr_apple_gpu_page *code_page,
+				      struct pvr_apple_gpu_page *out)
+{
+	static const u32 usc_store_marker[] = {
+		0x81891181, 0xacb74100, 0x030201c8, 0x01200101, 0x219846d1, 0x012f0300,
+		0x0154212a, 0x09000038, 0x0000010c, 0x01802312, 0x21c88000, 0x01840302,
+		0x010046d2, 0x0000010e, 0xc000c000, 0xc000c000, 0x00008000,
+	};
+	static const u32 stream[] = {
+		0x00000004, 0x00000902, 0x00003e00, 0, 0, 0, 0x40000001, 0,	/* binding */
+		0x00002103, 0x00000800, 0x00003f00, 0, 0, 0, 0x40000000, 0,	/* kernel */
+		0x80000000,							/* terminate */
+	};
+	u64 table = PVR_APPLE_GPU_CODE + 0x1000;
+	u8 *code = code_page->map;
+	unsigned int i;
+
+	wr32(out->map, 0, 0xabadbeef);
+	wr32(out->map, 4, 0xabadbeef);
+
+	/* Argument table entry: {buffer address, unused, 0x10001} */
+	wr32(code, 0x1000, lower_32_bits(PVR_APPLE_GPU_OUTPUT));
+	wr32(code, 0x1004, upper_32_bits(PVR_APPLE_GPU_OUTPUT));
+	wr32(code, 0x1010, 0x00010001);
+	/* Binding task data and code: DOUTD x2 from the table entry */
+	wr32(code, 0x900, lower_32_bits(table));
+	wr32(code, 0x904, upper_32_bits(table));
+	wr32(code, 0x908, lower_32_bits(table + 0x10));
+	wr32(code, 0x90c, upper_32_bits(table + 0x10));
+	wr32(code, 0x910, 0x10000002);
+	wr32(code, 0x918, 0x90004001);
+	wr32(code, 0x3e00, 0xf0001000);
+	wr32(code, 0x3e04, 0xf4001808);
+	wr32(code, 0x3e08, 0xd3000000);
+	/* Kernel task data (USC offset 0x2000, temps 2) and code */
+	wr32(code, 0x800, 0x2000);
+	wr32(code, 0x804, 0x10);
+	wr32(code, 0x808, 0x80000000);
+	wr32(code, 0x3f00, 0xc2c00002);
+	wr32(code, 0x3f04, 0xd3000000);
+	wr32(code, 0x3f08, 0xf0000a01);
+	wr32(code, 0x3f0c, 0xfc000002);
+	wr32(code, 0x3f10, 0xd3000000);
+	for (i = 0; i < ARRAY_SIZE(usc_store_marker); i++)
+		wr32(code, 0x2000 + 4 * i, usc_store_marker[i]);
+	for (i = 0; i < ARRAY_SIZE(stream); i++)
+		wr32(data->map, 4 * i, stream[i]);
+}
+
+/*
+ * Run subsequent jobs on @vm_ctx. GPU context 0 is reprogrammed directly
+ * (RGX MMU context mapping); bumping its generation makes the firmware
+ * invalidate the context's TLB before the next job. One VM at a time: the
+ * caller must ensure no job of another VM is in flight.
+ */
+static void pvr_apple_switch_vm(struct pvr_apple *apple, struct pvr_vm_context *vm_ctx)
+{
+	struct pvr_device *pvr_dev = apple->pvr_dev;
+	dma_addr_t root = pvr_vm_get_page_table_root_addr(vm_ctx);
+	__le32 *gen;
+
+	lockdep_assert_held(&apple->submit_lock);
+	if (root == apple->vm_root)
+		return;
+	*(__le64 *)(apple->heap + pvr_apple_layout_mmu_root_offset(0)) = cpu_to_le64(root);
+	pvr_cr_write32(pvr_dev, ROGUE_CR_MMU_CBASE_MAPPING_CONTEXT, 0);
+	pvr_cr_write32(pvr_dev, ROGUE_CR_MMU_CBASE_MAPPING, (u32)(root >> 12));
+	gen = (__le32 *)(apple->heap + pvr_apple_layout_mmu_gen_offset(0));
+	*gen = cpu_to_le32(le32_to_cpu(*gen) + 0x400000);	/* full invalidation */
+	wmb();
+	apple->vm_root = root;
+}
+
+/*
+ * Queue a compute job: CDM control stream at @stream, context-state buffer at
+ * @ctx_state (both GPU virtual addresses). Returns its sequence number, which
+ * the firmware writes to the completion stamp when the job retires.
+ */
+static u32 pvr_apple_submit_compute(struct pvr_apple *apple, struct pvr_vm_context *vm_ctx,
+				    u64 stream, u64 ctx_state)
+{
+	u32 seq;
+	int err;
+
+	mutex_lock(&apple->submit_lock);
+	pvr_apple_switch_vm(apple, vm_ctx);
+	seq = ++apple->last_seq;
+	pvr_apple_layout_write_compute_job(apple->heap, seq, stream, ctx_state);
+	wmb();
+	WRITE_ONCE(*(__le32 *)(apple->heap + pvr_apple_layout_compute_producer()),
+		   cpu_to_le32(seq));
+	wmb();
+	err = apple_rtkit_send_message(apple->rtk, APPLE_EP_AGX_DOORBELL, APPLE_MSG_KICK, NULL,
+				       false);
+	mutex_unlock(&apple->submit_lock);
+	if (err)
+		dev_err(apple_dev(apple), "doorbell for job %u failed: %d\n", seq, err);
+	return seq;
+}
+
+static u32 pvr_apple_completed_seq(struct pvr_apple *apple)
+{
+	return heap_read32(apple, pvr_apple_layout_stamp_offset());
+}
+
+static int pvr_apple_wait(struct pvr_apple *apple, u32 seq, unsigned int timeout_us)
+{
+	u32 done;
+
+	return read_poll_timeout(pvr_apple_completed_seq, done, (s32)(done - seq) >= 0, 1000,
+				 timeout_us, false, apple);
+}
+
+static int pvr_apple_selftest_job(struct pvr_apple *apple, bool store)
+{
+	u32 seq, out = 0;
+	int err;
+
+	if (store)
+		pvr_apple_write_store_job(&apple->data, &apple->code, &apple->out);
+	seq = pvr_apple_submit_compute(apple, apple->pvr_dev->kernel_vm_ctx, PVR_APPLE_GPU_DATA,
+				       PVR_APPLE_GPU_DATA + 0x2000);
+	err = pvr_apple_wait(apple, seq, 5000000);
+	if (store)
+		out = le32_to_cpu(READ_ONCE(*(__le32 *)apple->out.map));
+	dev_info(apple_dev(apple), "self-test: %s job %u %s (stamp %#x, out[0] %#x)\n",
+		 store ? "store" : "terminate-only", seq, err ? "did not complete" : "completed",
+		 pvr_apple_completed_seq(apple), out);
+	if (!err && store && out != 0x1357)
+		err = -EIO;
+	return err;
+}
+
+/*
+ * The store job in a second VM context with its own pages at the same GPU
+ * addresses: the marker must land in that context's output page only.
+ */
+static int pvr_apple_selftest_vm(struct pvr_apple *apple)
+{
+	struct pvr_device *pvr_dev = apple->pvr_dev;
+	struct pvr_apple_gpu_page data = {}, code = {}, out = {};
+	struct pvr_vm_context *vm_ctx;
+	u32 seq, kernel_out, vm_out;
+	int err;
+
+	vm_ctx = pvr_vm_create_context(pvr_dev, false);
+	if (IS_ERR(vm_ctx))
+		return PTR_ERR(vm_ctx);
+	err = pvr_apple_gpu_page_init_vm(apple, vm_ctx, &data, PVR_APPLE_GPU_DATA);
+	if (!err)
+		err = pvr_apple_gpu_page_init_vm(apple, vm_ctx, &code, PVR_APPLE_GPU_CODE);
+	if (!err)
+		err = pvr_apple_gpu_page_init_vm(apple, vm_ctx, &out, PVR_APPLE_GPU_OUTPUT);
+	if (err)
+		goto out;
+
+	/* Context store/load and terminate programs the CDM arguments name */
+	wr32(data.map, 0x1000, 0xd3000000);
+	wr32(code.map, 0x0000, 0xd3000000);
+	wr32(apple->out.map, 0, 0xabadbeef);
+	pvr_apple_write_store_job(&data, &code, &out);
+
+	seq = pvr_apple_submit_compute(apple, vm_ctx, PVR_APPLE_GPU_DATA,
+				       PVR_APPLE_GPU_DATA + 0x2000);
+	err = pvr_apple_wait(apple, seq, 5000000);
+	vm_out = le32_to_cpu(READ_ONCE(*(__le32 *)out.map));
+	kernel_out = le32_to_cpu(READ_ONCE(*(__le32 *)apple->out.map));
+	dev_info(apple_dev(apple),
+		 "self-test: store job %u in a second VM %s (vm out %#x, kernel out %#x)\n", seq,
+		 err ? "did not complete" : "completed", vm_out, kernel_out);
+	if (!err && (vm_out != 0x1357 || kernel_out != 0xabadbeef))
+		err = -EIO;
+
+	/* Back to the kernel context */
+	mutex_lock(&apple->submit_lock);
+	pvr_apple_switch_vm(apple, pvr_dev->kernel_vm_ctx);
+	mutex_unlock(&apple->submit_lock);
+out:
+	pvr_apple_gpu_page_fini_vm(apple, vm_ctx, &out);
+	pvr_apple_gpu_page_fini_vm(apple, vm_ctx, &code);
+	pvr_apple_gpu_page_fini_vm(apple, vm_ctx, &data);
+	pvr_vm_context_put(vm_ctx);
+	return err;
+}
+
+static void pvr_apple_selftest_compute(struct pvr_apple *apple)
+{
+	switch (pvr_apple_selftest) {
+	case 1:
+		pvr_apple_selftest_job(apple, false);
+		break;
+	case 2:
+		pvr_apple_selftest_job(apple, true);
+		break;
+	case 3:
+		if (!pvr_apple_selftest_job(apple, false))
+			pvr_apple_selftest_job(apple, true);
+		break;
+	case 4:
+		if (!pvr_apple_selftest_job(apple, true))
+			pvr_apple_selftest_vm(apple);
+		break;
+	}
+}
+
+int pvr_apple_fw_init(struct pvr_device *pvr_dev)
+{
+	struct pvr_apple *apple = to_apple(pvr_dev);
+	struct device *dev = apple_dev(apple);
+	u32 init = pvr_apple_layout_init_offset();
+	u32 ready;
+	int err;
+
+	err = pvr_apple_gpu_pages_init(apple);
+	if (err)
+		return err;
+
+	memset(apple->win + init, 0, PVR_APPLE_WINDOW_SIZE - init);
+	memset(apple->heap, 0, PVR_APPLE_HEAP_SIZE);
+	apple->vm_root = pvr_vm_get_page_table_root_addr(pvr_dev->kernel_vm_ctx);
+	pvr_apple_layout_build(apple->win, apple->win_dma, apple->heap, apple->heap_dma,
+			       apple->vm_root);
+	wmb();
+
+	err = apple_rtkit_send_message(apple->rtk, APPLE_EP_AGX_INIT,
+				       APPLE_MSG_INIT | (apple->win_dma + init), NULL, false);
+	if (err)
+		goto err_pages;
+	err = read_poll_timeout(heap_read32, ready, ready == 1, 1000, 3000000, false, apple,
+				HEAP_U_READY);
+	if (err) {
+		dev_err(dev, "GFX firmware did not accept init data\n");
+		goto err_pages;
+	}
+	dev_info(dev, "GFX firmware initialized (window %pad, heap %pad)\n", &apple->win_dma,
+		 &apple->heap_dma);
+
+	if (pvr_apple_selftest)
+		pvr_apple_selftest_compute(apple);
+	return 0;
+
+err_pages:
+	pvr_apple_gpu_pages_fini(apple);
+	return err;
+}
+
+void pvr_apple_fw_fini(struct pvr_device *pvr_dev)
+{
+	struct pvr_apple *apple = to_apple(pvr_dev);
+
+	pvr_apple_gpu_pages_fini(apple);
+	if (!apple->booted)
+		return;
+	pvr_apple_request_power_state(apple, 0);
+	apple_rtkit_shutdown(apple->rtk);
+	writel(readl(apple->fender + FENDER_RUN) & ~FENDER_RUN_ENABLE, apple->fender + FENDER_RUN);
+	apple->booted = false;
+}
+
+/*
+ * Static device information. Apple's firmware carries no IMG header, so the
+ * values come from the hardware (CORE_ID: 6 clusters) and the Rogue lineage.
+ */
+void pvr_apple_device_info_init(struct pvr_device *pvr_dev)
+{
+	pvr_dev->features.has_compute = true;
+	pvr_dev->features.has_cdm_control_stream_format = true;
+	pvr_dev->features.cdm_control_stream_format = 1;
+	pvr_dev->features.has_num_clusters = true;
+	pvr_dev->features.num_clusters = 6;
+	pvr_dev->features.has_phys_bus_width = true;
+	pvr_dev->features.phys_bus_width = 40;
+	pvr_dev->features.has_virtual_address_space_bits = true;
+	pvr_dev->features.virtual_address_space_bits = 40;
+	pvr_dev->features.has_tile_size_x = true;
+	pvr_dev->features.tile_size_x = 32;
+	pvr_dev->features.has_tile_size_y = true;
+	pvr_dev->features.tile_size_y = 32;
+}
diff --git a/drivers/gpu/drm/imagination/pvr_apple.h b/drivers/gpu/drm/imagination/pvr_apple.h
new file mode 100644
index 000000000..846abc260
--- /dev/null
+++ b/drivers/gpu/drm/imagination/pvr_apple.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* Apple A10 (T8010): Rogue hardware behind Apple's GFX firmware. */
+
+#ifndef PVR_APPLE_H
+#define PVR_APPLE_H
+
+#include <linux/errno.h>
+
+struct pvr_device;
+struct pvr_power_sequence_ops;
+
+extern const struct pvr_power_sequence_ops pvr_power_sequence_ops_apple;
+
+#if IS_ENABLED(CONFIG_DRM_POWERVR_APPLE)
+int pvr_apple_fw_init(struct pvr_device *pvr_dev);
+void pvr_apple_fw_fini(struct pvr_device *pvr_dev);
+void pvr_apple_device_info_init(struct pvr_device *pvr_dev);
+#else
+static inline int pvr_apple_fw_init(struct pvr_device *pvr_dev) { return -ENODEV; }
+static inline void pvr_apple_fw_fini(struct pvr_device *pvr_dev) {}
+static inline void pvr_apple_device_info_init(struct pvr_device *pvr_dev) {}
+#endif
+
+#endif /* PVR_APPLE_H */
diff --git a/drivers/gpu/drm/imagination/pvr_apple_layout.c b/drivers/gpu/drm/imagination/pvr_apple_layout.c
new file mode 100644
index 000000000..306674ee3
--- /dev/null
+++ b/drivers/gpu/drm/imagination/pvr_apple_layout.c
@@ -0,0 +1,410 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * Apple A10 (T8010) GPU firmware memory layout.
+ *
+ * Apple's GFX firmware runs on an A7 IOP with its own MMU. It sees two pieces of
+ * host memory:
+ *
+ *  - the window: 1 MiB at IOP address 0, holding the firmware image, the RTKit
+ *    buffers, the init page and the memory descriptors;
+ *  - the heap: host memory the firmware maps at fixed firmware virtual
+ *    addresses through those memory descriptors. It holds the firmware's
+ *    contexts, rings and queues, the GPU page tables of context 0 and the
+ *    command data.
+ *
+ * pvr_apple_layout_build() fills both from scratch. It is a pure function of
+ * the two buffers and their physical addresses, so the layout can be checked
+ * against reference images outside the kernel.
+ *
+ * Names follow the firmware's structures as far as they are understood:
+ *   X  main context (init+0x18): context pointers, ring indices, ring pointers
+ *   P  device context (X[0]): fixed GPU address windows, I/O table, unit masks
+ *   Q  flush scratch (X[1]), Z (X[2]), T MMU context table (init+0x1c)
+ *   U  debug/ready flags (init+0x98), V mapping-update ring (init+0x9c)
+ */
+
+#include "pvr_apple_layout.h"
+
+#define FW_VA_HEAP		0x00100000u	/* heap descriptor 0 */
+#define FW_VA_HEAP2		0x00140000u	/* heap descriptor 1, inner non-cacheable */
+#define HEAP2_OFFSET		0x50000u
+
+/* Window offsets (IOP address == window offset) */
+#define WIN_INIT		0x98000u
+#define WIN_DESC		0x9c000u
+
+/* Heap offsets of the firmware contexts */
+#define HEAP_X			0x00000u
+#define HEAP_P			0x02000u
+#define HEAP_T			0x04000u
+#define HEAP_U			0x05000u
+#define HEAP_Q			0x06000u
+#define HEAP_V			0x08000u
+#define HEAP_RING_INDICES	0x11000u
+#define HEAP_MMU_ROOTS		0x26000u
+#define HEAP_COMPUTE_RING	0x29000u
+#define HEAP_QUEUE		0x2b000u
+#define HEAP_QUEUE_STATE	0x2c000u
+#define HEAP_CMD_RING		0x2d000u
+#define HEAP_COMPUTE_CMD	0x2f000u
+#define HEAP_SEQ_PROGRAM	0x38000u
+#define HEAP_GPU_PC		0x40000u
+#define HEAP_GPU_PD		0x44000u
+#define HEAP_GPU_PT		0x48000u
+#define HEAP_MMU_GEN		0x52000u	/* fw VA 0x142000 */
+#define HEAP_CTX_STATE		0x53000u	/* fw VA 0x143000 */
+#define HEAP_USEQ		0x54000u	/* fw VA 0x144000: microsequence */
+#define HEAP_STAMP		0x55000u	/* fw VA 0x145000: completion stamps */
+#define HEAP_UNIT_STATE		0x56000u	/* fw VA 0x146000 */
+#define HEAP_CDM_ARGS		0x5b000u	/* fw VA 0x14b000 */
+#define HEAP_CDM_REGS		0x5c000u	/* fw VA 0x14c000 */
+#define HEAP_GPU_DATA		0x60000u	/* GPU VA 0x200000, 16 KiB */
+#define HEAP_PDS_PD		0x80000u
+#define HEAP_PDS_PT		0x7c000u
+#define HEAP_PDS_PAGE		0x84000u	/* GPU VA 0x300000000, 16 KiB */
+#define HEAP_JOBS		0x80000u	/* fw VA 0x170000: per-job slots */
+#define JOB_SLOTS		16u
+#define JOB_STRIDE		0x1000u
+#define JOB_CMD			0x000u		/* compute command, 0x2c8 bytes */
+#define JOB_USEQ		0x400u		/* microsequence, 0x80 bytes */
+#define JOB_CDM_ARGS		0x500u		/* CDM register arguments */
+#define RING_ENTRIES		256u
+#define WORK_ENTRY_SIZE		20u
+#define HEAP_IO_RAM		0x320000u	/* RAM behind unused I/O entries */
+
+/* P: I/O mapping table, 0x18-byte entries {pa lo, pa hi, fw va, size, flags, rw} */
+#define P_IO_TABLE		0x640u
+#define IO_ENTRY_SIZE		0x18u
+#define IO_FENDER		0
+#define IO_RGX			3
+#define IO_ENTRIES		7
+
+#define FENDER_PA		0x201d00000ull
+#define FENDER_SIZE		0x5000u
+#define RGX_PA			0x201000000ull
+#define RGX_SIZE		0x20000u
+
+/* GPU MMU entry flags (Rogue) */
+#define PC_VALID		0x1u
+#define PD_VALID_16K		0x3u	/* valid, 16 KiB leaf pages */
+#define PT_VALID		0x1u
+#define PT_SLC_BYPASS		0x8u
+#define PT_CC			0x4u	/* cache coherent */
+
+static inline void wr32(u8 *base, u32 offset, u32 value)
+{
+	base[offset + 0] = value;
+	base[offset + 1] = value >> 8;
+	base[offset + 2] = value >> 16;
+	base[offset + 3] = value >> 24;
+}
+
+static inline void wr16(u8 *base, u32 offset, u16 value)
+{
+	base[offset + 0] = value;
+	base[offset + 1] = value >> 8;
+}
+
+static inline void wr64(u8 *base, u32 offset, u64 value)
+{
+	wr32(base, offset, (u32)value);
+	wr32(base, offset + 4, (u32)(value >> 32));
+}
+
+/* Firmware VA of a heap offset, through descriptor 0 or 1 */
+static inline u32 fw_va(u32 offset)
+{
+	if (offset >= HEAP2_OFFSET)
+		return FW_VA_HEAP2 + (offset - HEAP2_OFFSET);
+	return FW_VA_HEAP + offset;
+}
+
+/* Memory descriptor: {fw va, pfn, 0, u16 pages, u16 flags}; flags 0 = inner non-cacheable */
+static void mem_desc(u8 *win, unsigned int index, u32 va, u64 pa, u16 pages)
+{
+	u32 entry = WIN_DESC + 16 * index;
+
+	wr32(win, entry + 0x0, va);
+	wr32(win, entry + 0x4, (u32)(pa >> 12));
+	wr32(win, entry + 0x8, 0);
+	wr16(win, entry + 0xc, pages);
+	wr16(win, entry + 0xe, 0);
+}
+
+static void io_entry(u8 *heap, unsigned int index, u64 pa, u32 size)
+{
+	u32 entry = HEAP_P + P_IO_TABLE + IO_ENTRY_SIZE * index;
+
+	wr64(heap, entry + 0x0, pa);
+	wr32(heap, entry + 0xc, size);
+	wr32(heap, entry + 0x10, 0);
+	wr32(heap, entry + 0x14, 1);	/* device, read/write */
+}
+
+static void build_main_context(u8 *heap)
+{
+	static const u32 page_pointers[] = {
+		0xe4, 0xe8, 0x134, 0x138, 0x13c, 0x140, 0x188,
+	};
+	unsigned int i;
+
+	wr32(heap, HEAP_X + 0x0, fw_va(HEAP_P));
+	wr32(heap, HEAP_X + 0x4, fw_va(HEAP_Q));
+	wr32(heap, HEAP_X + 0x8, fw_va(0x7000));	/* Z */
+
+	/* 13 rings: three index pointers each into the index page */
+	for (i = 0; i < 13; i++) {
+		wr32(heap, HEAP_X + 0xc + 0x10 * i, fw_va(HEAP_RING_INDICES + 0x10 * i));
+		wr32(heap, HEAP_X + 0x10 + 0x10 * i, fw_va(HEAP_RING_INDICES + 0x10 * i + 4));
+		wr32(heap, HEAP_X + 0x14 + 0x10 * i, fw_va(HEAP_RING_INDICES + 0x10 * i + 8));
+	}
+
+	/* Ring 2: compute work ring */
+	wr32(heap, HEAP_X + 0x38, fw_va(HEAP_COMPUTE_RING));
+
+	/* One zeroed page each, from fw VA 0x118000 on, in the order the
+	 * firmware expects them. +0xec..+0xf8 are trace rings, set below. */
+	for (i = 0; i < 2; i++)
+		wr32(heap, HEAP_X + page_pointers[i], fw_va(0x18000 + 0x1000 * i));
+	for (i = 2; i < 6; i++)
+		wr32(heap, HEAP_X + page_pointers[i], fw_va(0x1c000 + 0x1000 * (i - 2)));
+	wr32(heap, HEAP_X + 0x188, fw_va(0x20000));	/* acknowledged MMU generations */
+
+	wr32(heap, HEAP_X + 0xd8, fw_va(0x27000));	/* control ring data */
+	wr32(heap, HEAP_X + 0xdc, fw_va(0x57000));	/* event ring control */
+	wr32(heap, HEAP_X + 0xe0, fw_va(0x58000));	/* event ring entries */
+	wr32(heap, HEAP_X + 0xec, fw_va(0x75000));	/* SKU trace control */
+	wr32(heap, HEAP_X + 0xf0, fw_va(0x70000));	/* SKU trace records */
+	wr32(heap, HEAP_X + 0xf4, fw_va(0x68000));	/* firmware trace control */
+	wr32(heap, HEAP_X + 0xf8, fw_va(0x64000));	/* firmware trace records */
+
+	/* X+0x301 (unaligned): power-state struct at fw VA 0x130000 */
+	heap[HEAP_X + 0x303] = 0x13;
+}
+
+static void build_device_context(u8 *heap, u64 heap_pa)
+{
+	unsigned int k;
+
+	/* Fixed GPU address windows, as the kext initializes P[0..0x27] */
+	wr64(heap, HEAP_P + 0x00, 0x600000000ull);
+	wr64(heap, HEAP_P + 0x08, 0xffc00000ull);
+	wr64(heap, HEAP_P + 0x10, 0x300000000ull);	/* PDS exec base */
+	wr64(heap, HEAP_P + 0x18, 0x300000000ull);	/* USC code base */
+	wr64(heap, HEAP_P + 0x20, 0x1ffff8000ull);
+
+	io_entry(heap, IO_FENDER, FENDER_PA, FENDER_SIZE);
+	io_entry(heap, IO_RGX, RGX_PA, RGX_SIZE);
+	for (k = 1; k < IO_ENTRIES; k++) {
+		if (k == IO_RGX)
+			continue;
+		io_entry(heap, k, heap_pa + HEAP_IO_RAM + 0x20000 * k, 0x20000);
+	}
+
+	/* One scheduling unit per TA/3D/compute engine */
+	wr32(heap, HEAP_P + 0x16c0, 1);
+	wr32(heap, HEAP_P + 0x16c4, 1);
+	wr32(heap, HEAP_P + 0x16c8, 1);
+}
+
+static void build_gpu_mmu(u8 *heap, u64 gpu_root)
+{
+	/* Context-0 root array (T+0x7e0) and MMU generations (T+0x7dc) */
+	wr32(heap, HEAP_T + 0x7dc, fw_va(HEAP_MMU_GEN));
+	wr32(heap, HEAP_T + 0x7e0, fw_va(HEAP_MMU_ROOTS));
+	wr64(heap, HEAP_MMU_ROOTS, gpu_root);
+	wr32(heap, HEAP_MMU_GEN, 0x400000);	/* forces a full invalidation */
+}
+
+/*
+ * Reference layout only: hand-built context-0 page tables and pages in the
+ * heap, as the bring-up experiments used them. The driver maps GEM objects
+ * through pvr_vm instead and passes that context's root.
+ */
+static void build_reference_gpu_pages(u8 *heap, u64 heap_pa)
+{
+	/* GPU VA 0x200000 -> 16 KiB data page (stream, PDS, flush scratch) */
+	wr32(heap, HEAP_GPU_PC + 0, (u32)(((heap_pa + HEAP_GPU_PD) >> 12) << 4) | PC_VALID);
+	wr64(heap, HEAP_GPU_PD + 8, (heap_pa + HEAP_GPU_PT) | PD_VALID_16K);
+	wr64(heap, HEAP_GPU_PT, (heap_pa + HEAP_GPU_DATA) | PT_SLC_BYPASS | PT_VALID);
+
+	/* GPU VA 0x300000000 -> 16 KiB PDS/USC code page, read-only */
+	wr32(heap, HEAP_GPU_PC + 12 * 4, (u32)(((heap_pa + HEAP_PDS_PD) >> 12) << 4) | PC_VALID);
+	wr64(heap, HEAP_PDS_PD, (heap_pa + HEAP_PDS_PT) | PD_VALID_16K);
+	wr64(heap, HEAP_PDS_PT, (heap_pa + HEAP_PDS_PAGE) | PT_SLC_BYPASS | PT_CC | PT_VALID);
+
+	/* Terminate-only stream and HALT programs */
+	wr32(heap, HEAP_GPU_DATA + 0x0000, 0x80000000);
+	wr32(heap, HEAP_GPU_DATA + 0x1000, 0xd3000000);
+	wr32(heap, HEAP_PDS_PAGE, 0xd3000000);
+}
+
+static void build_compute_queue(u8 *heap)
+{
+	/* Compute work ring descriptor 0 -> queue, engine 2 (compute), head 1 */
+	wr32(heap, HEAP_COMPUTE_RING + 0x8, fw_va(HEAP_QUEUE));
+	wr32(heap, HEAP_COMPUTE_RING + 0xc, 2);
+	wr16(heap, HEAP_COMPUTE_RING + 0x10, 1);
+
+	wr32(heap, HEAP_QUEUE + 0x00, fw_va(HEAP_QUEUE_STATE));
+	wr32(heap, HEAP_QUEUE + 0x04, fw_va(HEAP_CMD_RING));
+	wr32(heap, HEAP_QUEUE + 0x0c, FW_VA_HEAP2);	/* scheduling entries */
+	wr32(heap, HEAP_QUEUE + 0x44, 1);		/* hardware unit mask */
+	wr32(heap, HEAP_QUEUE + 0x88, fw_va(0x2e000));
+	wr32(heap, HEAP_QUEUE_STATE + 0x50, 256);
+	wr32(heap, HEAP_CMD_RING, fw_va(HEAP_COMPUTE_CMD));
+}
+
+/*
+ * The compute command of the reference job: Start, WaitIRQ (compute finished),
+ * Finalize, End, with a host completion stamp at fw VA 0x145004.
+ */
+/*
+ * CDM register arguments: context/storage base (RGX+0x498), terminate PDS
+ * code/data (the driver's HALT program), control stream base (RGX+0x480).
+ */
+static void write_cdm_args(u8 *heap, u32 args, u64 stream, u64 ctx_state)
+{
+	wr64(heap, args + 0x00, ctx_state);
+	wr32(heap, args + 0x08, 0x201000);
+	wr32(heap, args + 0x0c, 0x201010);
+	wr64(heap, args + 0x10, stream);
+}
+
+/*
+ * Microsequence of a compute job: StartCompute, WaitIRQ (compute finished),
+ * FinalizeCompute, End. Finalize writes @seq to the first completion stamp.
+ */
+static void write_microsequence(u8 *heap, u32 useq, u32 cdm_args, u32 seq)
+{
+	/* StartCompute (0x48 bytes) */
+	wr32(heap, useq + 0x00, 11);
+	wr32(heap, useq + 0x04, fw_va(HEAP_CDM_REGS));
+	wr32(heap, useq + 0x08, fw_va(cdm_args));
+	wr32(heap, useq + 0x0c, fw_va(0x1e000));	/* shared unit states */
+	wr32(heap, useq + 0x2c, fw_va(HEAP_CTX_STATE));
+	wr32(heap, useq + 0x38, fw_va(HEAP_UNIT_STATE + 0x100));
+	wr32(heap, useq + 0x44, fw_va(HEAP_UNIT_STATE + 0x108));
+	/* WaitIRQ: compute finished */
+	wr32(heap, useq + 0x48, 0x100);
+	/* FinalizeCompute (0x30 bytes) */
+	wr32(heap, useq + 0x4c, 12);
+	wr32(heap, useq + 0x50, fw_va(0x1e000));
+	wr32(heap, useq + 0x68, fw_va(HEAP_STAMP));
+	wr32(heap, useq + 0x6c, seq);
+	wr32(heap, useq + 0x74, fw_va(HEAP_UNIT_STATE + 0x100));
+	/* End */
+	wr32(heap, useq + 0x7c, 2);
+}
+
+static void write_compute_command(u8 *heap, u32 cmd, u32 useq, u32 seq)
+{
+	wr32(heap, cmd + 0x000, 3);
+	wr32(heap, cmd + 0x014, fw_va(HEAP_CTX_STATE));
+	wr32(heap, cmd + 0x1e8, fw_va(useq));
+	wr32(heap, cmd + 0x1ec, 0x80);			/* microsequence size */
+	wr32(heap, cmd + 0x26c, fw_va(HEAP_STAMP + 4));	/* host stamp address */
+	wr32(heap, cmd + 0x274, seq);			/* stamp value */
+}
+
+static void build_compute_command(u8 *heap)
+{
+	/* Reference job 1 (the bring-up layout); the driver writes per-job slots */
+	write_compute_command(heap, HEAP_COMPUTE_CMD, HEAP_USEQ, 1);
+	write_microsequence(heap, HEAP_USEQ, HEAP_CDM_ARGS, 1);
+
+	wr32(heap, HEAP_UNIT_STATE + 0x108, 1);
+
+	write_cdm_args(heap, HEAP_CDM_ARGS, 0x200000, 0x202000);
+	/* Context store/load PDS program (RGX_CDM_CONTEXT_PDS0) */
+	wr32(heap, HEAP_CTX_STATE + 0x38, 0x201000);
+	wr32(heap, HEAP_CTX_STATE + 0x3c, 0x201010);
+
+	/* Q: flush scratch/fence address, programmed into RGX+0xe240 */
+	wr64(heap, HEAP_Q, 0x203000);
+}
+
+static void build_init_page(u8 *win, u64 win_pa, u64 heap_pa)
+{
+	wr64(win, WIN_INIT + 0x08, heap_pa + HEAP_SEQ_PROGRAM);	/* empty sequence */
+	wr32(win, WIN_INIT + 0x18, fw_va(HEAP_X));
+	wr32(win, WIN_INIT + 0x1c, fw_va(HEAP_T));
+	wr64(win, WIN_INIT + 0x8c, win_pa + WIN_DESC);
+	wr32(win, WIN_INIT + 0x94, 2);			/* descriptor count */
+	wr32(win, WIN_INIT + 0x98, fw_va(HEAP_U));
+	wr32(win, WIN_INIT + 0x9c, fw_va(HEAP_V));
+	wr32(win, WIN_INIT + 0xa0, fw_va(0x10000));	/* power path page */
+
+	mem_desc(win, 0, FW_VA_HEAP, heap_pa, 56);
+	mem_desc(win, 1, FW_VA_HEAP2, heap_pa + HEAP2_OFFSET, 64);
+}
+
+void pvr_apple_layout_build(u8 *win, u64 win_pa, u8 *heap, u64 heap_pa, u64 gpu_root)
+{
+	build_init_page(win, win_pa, heap_pa);
+	build_main_context(heap);
+	build_device_context(heap, heap_pa);
+	if (gpu_root) {
+		build_gpu_mmu(heap, gpu_root);
+	} else {
+		build_gpu_mmu(heap, heap_pa + HEAP_GPU_PC);
+		build_reference_gpu_pages(heap, heap_pa);
+	}
+	build_compute_queue(heap);
+	build_compute_command(heap);
+
+	wr32(heap, HEAP_U + 0x0, 3);			/* debug flags */
+	wr32(heap, HEAP_V + 0x455c, fw_va(0x24000));	/* mapping ring control */
+	wr32(heap, HEAP_V + 0x4560, fw_va(0x25000));	/* mapping ring entries */
+	wr32(heap, HEAP_V + 0x45b4, 1);			/* engine scheduler init */
+}
+
+/*
+ * Queue compute job @seq (1, 2, ...): its slot, command-ring entry @seq - 1 and
+ * work-ring descriptor. The caller then sets the producer index to @seq and
+ * rings the doorbell; completion shows as @seq in the stamp.
+ */
+void pvr_apple_layout_write_compute_job(u8 *heap, u32 seq, u64 stream, u64 ctx_state)
+{
+	u32 slot = HEAP_JOBS + ((seq - 1) % JOB_SLOTS) * JOB_STRIDE;
+	u32 work = HEAP_COMPUTE_RING + ((seq - 1) % RING_ENTRIES) * WORK_ENTRY_SIZE;
+	u32 i;
+
+	for (i = 0; i < JOB_STRIDE; i++)
+		heap[slot + i] = 0;
+	write_compute_command(heap, slot + JOB_CMD, slot + JOB_USEQ, seq);
+	write_microsequence(heap, slot + JOB_USEQ, slot + JOB_CDM_ARGS, seq);
+	write_cdm_args(heap, slot + JOB_CDM_ARGS, stream, ctx_state);
+
+	wr32(heap, HEAP_CMD_RING + 4 * ((seq - 1) % RING_ENTRIES), fw_va(slot + JOB_CMD));
+	for (i = 0; i < WORK_ENTRY_SIZE; i++)
+		heap[work + i] = 0;
+	wr32(heap, work + 0x8, fw_va(HEAP_QUEUE));
+	wr32(heap, work + 0xc, 2);			/* engine: compute */
+	wr16(heap, work + 0x10, seq);			/* target command-ring head */
+}
+
+u32 pvr_apple_layout_mmu_root_offset(unsigned int ctx)
+{
+	return HEAP_MMU_ROOTS + 8 * ctx;
+}
+
+u32 pvr_apple_layout_mmu_gen_offset(unsigned int ctx)
+{
+	return HEAP_MMU_GEN + 4 * ctx;
+}
+
+u32 pvr_apple_layout_init_offset(void)
+{
+	return WIN_INIT;
+}
+
+u32 pvr_apple_layout_compute_producer(void)
+{
+	return HEAP_RING_INDICES + 0x28;	/* ring 2 producer index */
+}
+
+u32 pvr_apple_layout_stamp_offset(void)
+{
+	return HEAP_STAMP + 4;
+}
diff --git a/drivers/gpu/drm/imagination/pvr_apple_layout.h b/drivers/gpu/drm/imagination/pvr_apple_layout.h
new file mode 100644
index 000000000..414a41eba
--- /dev/null
+++ b/drivers/gpu/drm/imagination/pvr_apple_layout.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* Apple A10 (T8010) GPU firmware memory layout; see pvr_apple_layout.c. */
+
+#ifndef PVR_APPLE_LAYOUT_H
+#define PVR_APPLE_LAYOUT_H
+
+#include <linux/types.h>
+
+#define PVR_APPLE_WINDOW_SIZE	0x100000u	/* IOP window: image, RTKit, init */
+#define PVR_APPLE_FW_RUNTIME	0x8f000u	/* image + firmware runtime data */
+#define PVR_APPLE_HEAP_SIZE	0x400000u
+
+/*
+ * gpu_root: physical address of the context-0 GPU page-table root, or 0 for the
+ * reference layout with hand-built tables and pages inside the heap.
+ */
+void pvr_apple_layout_build(u8 *win, u64 win_pa, u8 *heap, u64 heap_pa, u64 gpu_root);
+
+/* GPU virtual addresses the compute command and its CDM arguments use */
+#define PVR_APPLE_GPU_DATA	0x200000ull	/* stream at +0, PDS HALT at +0x1000 */
+#define PVR_APPLE_GPU_FLUSH	0x203000ull	/* flush scratch (Q) */
+#define PVR_APPLE_GPU_OUTPUT	0x204000ull
+#define PVR_APPLE_GPU_CODE	0x300000000ull	/* PDS exec base = USC code base */
+void pvr_apple_layout_write_compute_job(u8 *heap, u32 seq, u64 stream, u64 ctx_state);
+u32 pvr_apple_layout_mmu_root_offset(unsigned int ctx);
+u32 pvr_apple_layout_mmu_gen_offset(unsigned int ctx);
+u32 pvr_apple_layout_init_offset(void);
+u32 pvr_apple_layout_compute_producer(void);
+u32 pvr_apple_layout_stamp_offset(void);
+
+#endif /* PVR_APPLE_LAYOUT_H */
