#version 450
// julia.comp with its constants from push constants, read inside the loop
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer B { uint d[]; };
layout(push_constant) uniform P { float scale, offset; };
void main()
{
   uint i = gl_GlobalInvocationID.x;
   float zx = (float(i & 63u) - 32.0) * 0.05, zy = (float(i >> 6) - 32.0) * 0.05;
   uint n = 0u;
   for (; n < 32u; n++) {
      float xx = zx * zx, yy = zy * zy;
      if (xx + yy > 16.0)
         break;
      zy = 2.0 * zx * zy + offset;
      zx = xx - yy - scale * 0.5;
   }
   d[i] = n;
}
